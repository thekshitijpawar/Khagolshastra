# ==========================================
# Khagolshastra Platform Environment Variables
# Copy this file to .env and configure values.
# NEVER commit real credentials or .env to git.
# ==========================================

# 1. Database Connection (PostgreSQL or SQLite)
POSTGRES_USER=khagol
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=khagolshastra
DATABASE_URL=postgresql://khagol:your_secure_db_password_here@localhost:5432/khagolshastra

# 2. Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# 3. Security & Admin Authentication Key
# Generate with: openssl rand -hex 32
SECRET_KEY=your_64_character_cryptographic_secret_key_here

# 4. Search Engine (MeiliSearch)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=your_secure_meili_master_key_here

# 5. Frontend Public Configuration (Browser-Safe Only)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 6. Optional Academic API Tokens (Server-Side Only - Never prefix with NEXT_PUBLIC_)
ADS_API_TOKEN=your_nasa_ads_api_token_here
NASA_API_KEY=your_nasa_gov_api_key_here
